// Copy this file to secrets.h (same directory) and fill in your own values.
// secrets.h is gitignored - never commit real credentials.
//
// These are only the compile-time FALLBACK used when NVS has no persisted config yet (e.g. right
// after a fresh flash, before the captive config portal has been used once) - see lib/Config.
// Once configured via the portal, the persisted values in NVS take priority and this file is no
// longer consulted.
#pragma once

constexpr char kWifiSsid[] = "your-network-name";
constexpr char kWifiPassword[] = "your-network-password";

// Full wss:// (or ws://) URL of the remote-BLE-adapter WebSocket endpoint, e.g.
// "wss://storage.bliksoft.cz/ble-remote".
constexpr char kWsUrl[] = "wss://your-server/ble-remote";

// Sent as the X-BLE-Remote-Name handshake header - identifies this device's "channel" to the
// server's RemoteAdapterRegistry.
constexpr char kChannelName[] = "esp32-ble-bridge-1";

// Sent as "Authorization: Bearer <token>" on the WebSocket handshake.
constexpr char kBearerToken[] = "your-bearer-token";

// true = skip TLS certificate verification entirely (WiFiClientSecure::setInsecure()) - useful on
// a local network with a self-signed cert where uploading a trusted CA would be more trouble than
// it's worth. false = verify against the built-in CA bundle (the right choice for a real public
// host like storage.bliksoft.cz).
constexpr bool kTlsInsecure = false;
